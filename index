<!DOCTYPE html>
<html lang="th">
<head>
<meta charset="UTF-8">
<meta name="viewport"
      content="width=device-width, initial-scale=1.0,
               maximum-scale=1.0, user-scalable=no">

<title>Flowchart Playground ป.3</title>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Prompt:wght@300;400;500;600;700&display=swap"
      rel="stylesheet">

<style>
:root {
  --primary:#4338ca;
  --primary-light:#6366f1;
  --primary-bg:#eef2ff;

  --bg:#f1f5f9;
  --card:#ffffff;
  --text:#1e293b;
  --muted:#64748b;
  --border:#cbd5e1;

  --terminal-bg:#d1fae5;
  --terminal-border:#10b981;

  --process-bg:#e0f2fe;
  --process-border:#0284c7;

  --decision-bg:#fef9c3;
  --decision-border:#ca8a04;

  --success:#15803d;
  --success-bg:#dcfce7;

  --danger:#b91c1c;
  --danger-bg:#fee2e2;

  --warning:#b45309;
  --warning-bg:#fef3c7;
}

* {
  box-sizing:border-box;
  font-family:'Prompt',sans-serif;
  margin:0;
  padding:0;
  -webkit-tap-highlight-color:transparent;
}

html,
body {
  width:100%;
  height:100%;
}

body {
  background:var(--bg);
  color:var(--text);
  overflow:hidden;
  touch-action:manipulation;
}

/* ================= HEADER ================= */

header {
  height:72px;
  background:white;
  border-bottom:2px solid var(--border);
  display:flex;
  align-items:center;
  justify-content:space-between;
  padding:10px 20px;
  box-shadow:0 2px 6px rgba(0,0,0,.05);
  position:relative;
  z-index:20;
}

.logo-area {
  display:flex;
  align-items:center;
  gap:10px;
}

.logo-icon {
  font-size:32px;
}

.logo-area h1 {
  color:var(--primary);
  font-size:1.25rem;
  line-height:1.1;
}

.badge-grade {
  display:inline-block;
  margin-top:3px;
  background:#e0e7ff;
  color:var(--primary);
  padding:2px 10px;
  border-radius:999px;
  font-size:.78rem;
  font-weight:600;
}

.header-actions {
  display:flex;
  align-items:center;
  gap:10px;
}

.task-dropdown {
  min-height:42px;
  padding:7px 12px;
  border:1.5px solid var(--primary-light);
  border-radius:9px;
  background:white;
  color:var(--text);
  font-weight:500;
  font-size:.88rem;
  outline:none;
}

.btn {
  min-height:42px;
  border-radius:9px;
  padding:8px 15px;
  border:none;
  font-size:.9rem;
  font-weight:600;
  cursor:pointer;
  display:flex;
  align-items:center;
  justify-content:center;
  gap:6px;
  transition:.2s;
  touch-action:manipulation;
}

.btn-primary {
  background:var(--primary);
  color:white;
}

.btn-primary:active {
  transform:scale(.97);
}

.btn-outline {
  background:white;
  border:1.5px solid var(--border);
  color:var(--text);
}

/* ================= SCORE ================= */

.score-bar {
  position:absolute;
  left:50%;
  transform:translateX(-50%);
  display:flex;
  align-items:center;
  gap:8px;
}

.score-item {
  background:#f8fafc;
  border:1px solid var(--border);
  padding:5px 12px;
  border-radius:999px;
  font-size:.82rem;
  font-weight:600;
}

/* ================= MAIN ================= */

.app-workspace {
  height:calc(100vh - 72px);
  display:grid;
  grid-template-columns:310px minmax(400px,1fr) 285px;
  overflow:hidden;
}

/* ================= LEFT ================= */

.panel-left {
  background:white;
  border-right:1px solid var(--border);
  padding:16px;
  overflow-y:auto;
  -webkit-overflow-scrolling:touch;
}

.card-info {
  background:#f8fafc;
  border-left:4px solid var(--primary);
  padding:12px;
  border-radius:7px;
  margin-bottom:14px;
}

.card-info h3 {
  font-size:.95rem;
  color:var(--primary);
  margin-bottom:5px;
}

.card-info p {
  color:var(--muted);
  font-size:.83rem;
  line-height:1.45;
}

.section-title {
  font-size:.86rem;
  font-weight:600;
  color:#475569;
  margin-bottom:9px;
}

.block-list {
  display:flex;
  flex-direction:column;
  gap:9px;
}

.flow-block-source {
  min-height:58px;
  padding:9px 11px;
  border:2px solid var(--border);
  border-radius:9px;
  background:white;
  display:flex;
  align-items:center;
  gap:9px;
  font-size:.84rem;
  font-weight:500;
  cursor:pointer;

  user-select:none;
  -webkit-user-select:none;

  transition:.2s;
}

.flow-block-source:active {
  transform:scale(.98);
}

.flow-block-source.used {
  opacity:.35;
  filter:grayscale(1);
}

.flow-block-source.selected {
  border-color:var(--primary);
  background:var(--primary-bg);
  box-shadow:0 0 0 3px rgba(99,102,241,.12);
}

/* ================= SHAPES ================= */

.shape-tag {
  width:34px;
  height:24px;
  border:2px solid #334155;
  display:inline-flex;
  align-items:center;
  justify-content:center;
  flex-shrink:0;
}

.shape-terminal {
  border-radius:14px;
  background:var(--terminal-bg);
  border-color:var(--terminal-border);
}

.shape-process {
  border-radius:3px;
  background:var(--process-bg);
  border-color:var(--process-border);
}

.shape-decision {
  transform:rotate(45deg) scale(.68);
  background:var(--decision-bg);
  border-color:var(--decision-border);
}

/* ================= CENTER ================= */

.panel-center {
  background:#f8fafc;
  overflow-y:auto;
  padding:22px 18px 40px;
  -webkit-overflow-scrolling:touch;
}

.center-header {
  max-width:560px;
  margin:0 auto 14px;
  display:flex;
  justify-content:space-between;
  align-items:center;
}

.center-title {
  font-weight:700;
  color:#334155;
}

.progress-text {
  font-size:.82rem;
  color:var(--muted);
}

.chart-flow-container {
  width:100%;
  max-width:560px;
  margin:auto;
  display:flex;
  flex-direction:column;
  align-items:center;
}

.drop-slot {
  width:100%;
  min-height:68px;
  border:2px dashed #94a3b8;
  background:white;
  border-radius:11px;

  display:flex;
  align-items:center;
  justify-content:center;

  transition:.2s;
}

.drop-slot.drag-over {
  border-color:var(--primary);
  background:var(--primary-bg);
  transform:scale(1.015);
}

.drop-slot.highlight {
  border-color:var(--primary);
  background:#eef2ff;
  box-shadow:0 0 0 4px rgba(99,102,241,.08);
}

.empty-placeholder {
  color:#94a3b8;
  font-size:.83rem;
  text-align:center;
  padding:8px;
}

.placed-block {
  width:100%;
  min-height:64px;
  padding:9px 12px;

  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:8px;

  border:2px solid;
  border-radius:9px;

  animation:popIn .2s ease;
}

.placed-block.type-terminal {
  background:var(--terminal-bg);
  border-color:var(--terminal-border);
}

.placed-block.type-process {
  background:var(--process-bg);
  border-color:var(--process-border);
}

.placed-block.type-decision {
  background:var(--decision-bg);
  border-color:var(--decision-border);
}

.block-text {
  display:flex;
  align-items:center;
  gap:9px;
  font-size:.85rem;
  font-weight:500;
}

.btn-remove-slot {
  width:32px;
  height:32px;
  border:none;
  border-radius:7px;
  background:rgba(0,0,0,.05);
  color:#64748b;
  cursor:pointer;
  flex-shrink:0;
  font-size:16px;
}

.btn-remove-slot:active {
  background:rgba(185,28,28,.12);
  color:var(--danger);
}

.flow-connector-line {
  width:3px;
  height:25px;
  background:#64748b;
  position:relative;
  margin:3px 0;
}

.flow-connector-line::after {
  content:"";
  position:absolute;
  bottom:-1px;
  left:-4px;

  border-left:5px solid transparent;
  border-right:5px solid transparent;
  border-top:8px solid #64748b;
}

/* ================= RIGHT ================= */

.panel-right {
  background:white;
  border-left:1px solid var(--border);
  padding:16px;
  overflow-y:auto;
  -webkit-overflow-scrolling:touch;
}

.guide-card {
  background:#faf5ff;
  border:1px solid #e9d5ff;
  border-radius:9px;
  padding:13px;
  margin-bottom:14px;
}

.guide-card h4 {
  color:#6b21a8;
  font-size:.92rem;
  margin-bottom:12px;
}

.guide-item {
  display:flex;
  gap:9px;
  align-items:flex-start;
  margin-bottom:11px;
  font-size:.78rem;
  line-height:1.4;
}

.guide-item:last-child {
  margin-bottom:0;
}

.action-card {
  background:#f8fafc;
  border:1px solid var(--border);
  border-radius:9px;
  padding:12px;
}

.action-card .btn {
  width:100%;
  margin-bottom:9px;
}

.action-card .btn:last-child {
  margin-bottom:0;
}

/* ================= FEEDBACK ================= */

.status-box {
  display:none;
  margin-top:12px;
  padding:13px;
  border-radius:9px;
  font-size:.83rem;
  line-height:1.5;
}

.status-success {
  background:var(--success-bg);
  color:var(--success);
  border:1.5px solid #86efac;
}

.status-error {
  background:var(--danger-bg);
  color:var(--danger);
  border:1.5px solid #fca5a5;
}

.status-warning {
  background:var(--warning-bg);
  color:var(--warning);
  border:1.5px solid #fcd34d;
}

/* ================= MODAL ================= */

.modal-overlay {
  position:fixed;
  inset:0;
  background:rgba(15,23,42,.55);
  display:none;
  align-items:center;
  justify-content:center;
  z-index:100;
  padding:20px;
}

.modal {
  background:white;
  width:min(440px,100%);
  border-radius:18px;
  padding:25px;
  text-align:center;
  box-shadow:0 20px 60px rgba(0,0,0,.25);
  animation:popIn .25s ease;
}

.modal-icon {
  font-size:58px;
  margin-bottom:8px;
}

.modal h2 {
  color:var(--primary);
  margin-bottom:8px;
}

.modal p {
  color:var(--muted);
  font-size:.9rem;
  line-height:1.5;
  margin-bottom:16px;
}

.final-score {
  font-size:2rem;
  font-weight:700;
  color:var(--primary);
  margin:10px 0 18px;
}

/* ================= ANIMATION ================= */

@keyframes popIn {
  from {
    opacity:0;
    transform:scale(.92);
  }
  to {
    opacity:1;
    transform:scale(1);
  }
}

@keyframes shake {
  0%,100% {transform:translateX(0);}
  25% {transform:translateX(-5px);}
  75% {transform:translateX(5px);}
}

.shake {
  animation:shake .25s ease;
}

/* ================= RESPONSIVE ================= */

@media (max-width:1100px) {

  .app-workspace {
    grid-template-columns:270px 1fr;
  }

  .panel-right {
    display:none;
  }

  .score-bar {
    position:static;
    transform:none;
  }
}

@media (max-width:760px) {

  body {
    overflow:auto;
  }

  header {
    height:auto;
    min-height:70px;
    flex-wrap:wrap;
    gap:8px;
  }

  .logo-area h1 {
    font-size:1rem;
  }

  .badge-grade {
    font-size:.7rem;
  }

  .score-bar {
    order:3;
    width:100%;
    justify-content:center;
  }

  .header-actions {
    margin-left:auto;
  }

  .task-dropdown {
    max-width:170px;
    font-size:.75rem;
  }

  .header-actions .btn {
    font-size:0;
    padding:8px 11px;
  }

  .header-actions .btn:first-letter {
    font-size:1rem;
  }

  .app-workspace {
    height:auto;
    min-height:calc(100vh - 130px);
    display:flex;
    flex-direction:column;
  }

  .panel-left {
    border-right:none;
    border-bottom:1px solid var(--border);
    max-height:310px;
  }

  .block-list {
    display:grid;
    grid-template-columns:1fr 1fr;
  }

  .panel-center {
    min-height:600px;
  }

  .chart-flow-container {
    max-width:100%;
  }
}

/* iPad landscape */
@media (min-width:768px) and (max-width:1200px) {

  .app-workspace {
    grid-template-columns:280px 1fr;
  }

  .panel-right {
    display:none;
  }

  .flow-block-source {
    min-height:62px;
  }

  .drop-slot {
    min-height:72px;
  }
}
</style>
