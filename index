      {
        id:"c4",
        text:"ยกอาหารมาเสิร์ฟและรับชำระเงิน",
        shape:"process"
      },

      {
        id:"c5",
        text:"สิ้นสุด (End)",
        shape:"terminal"
      }

    ],

    solution:["c1","c2","c3","c4","c5"]

  },


  shoes: {

    title:"ภารกิจที่ 4: การซักรองเท้าผ้าใบด้วยมือ",

    desc:"เรียงขั้นตอนการทำความสะอาดรองเท้าผ้าใบตามขั้นตอนการแก้ปัญหา",

    stepsCount:5,

    blocks:[

      {
        id:"s1",
        text:"เริ่มต้น (Start)",
        shape:"terminal"
      },

      {
        id:"s2",
        text:"ถอดเชือกรองเท้าและแช่น้ำผสมผงซักฟอก",
        shape:"process"
      },

      {
        id:"s3",
        text:"ใช้แปรงขัดสิ่งสกปรกออกแล้วล้างน้ำสะอาด",
        shape:"process"
      },

      {
        id:"s4",
        text:"นำรองเท้าไปตากจนแห้งสนิท",
        shape:"process"
      },

      {
        id:"s5",
        text:"สิ้นสุด (End)",
        shape:"terminal"
      }

    ],

    solution:["s1","s2","s3","s4","s5"]

  }

};


/* =====================================================
   VARIABLES
===================================================== */

let activeKey = "market";

let boardSlots = {};

let totalScore = 0;

let attempts = 0;

let taskCompleted = false;


/* =====================================================
   INITIALIZE
===================================================== */

function init() {

  loadTask(activeKey);

  updateScore();

}


/* =====================================================
   CHANGE TASK
===================================================== */

function changeTask(key) {

  activeKey = key;

  taskCompleted = false;

  resetBoard();

}


/* =====================================================
   RESET
===================================================== */

function resetBoard() {

  boardSlots = {};

  taskCompleted = false;

  loadTask(activeKey);

}


/* =====================================================
   LOAD TASK
===================================================== */

function loadTask(key) {

  const task = tasks[key];

  document.getElementById(
    "taskTitleDisplay"
  ).textContent = task.title;

  document.getElementById(
    "taskDescDisplay"
  ).textContent = task.desc;

  document.getElementById(
    "totalDisplay"
  ).textContent = task.stepsCount;


  const feedback =
    document.getElementById("feedbackBox");

  feedback.style.display="none";


  /* ---------- TOOLBOX ---------- */

  const toolbox =
    document.getElementById("toolboxContainer");

  toolbox.innerHTML="";


  const shuffled =
    [...task.blocks].sort(
      () => Math.random() - .5
    );


  shuffled.forEach(block => {

    const item =
      document.createElement("div");

    item.className =
      "flow-block-source";

    item.id =
      `block-${block.id}`;

    item.innerHTML = `

      <span class="shape-tag shape-${block.shape}">
      </span>

      <span>${block.text}</span>

    `;


    /*
      คลิก / แตะ
      สำหรับ iPad
    */

    item.addEventListener(
      "click",
      () => {

        fillNextAvailableSlot(block.id);

      }
    );


    /*
      Drag & Drop
      สำหรับเมาส์/Trackpad
    */

    item.draggable=true;

    item.addEventListener(
      "dragstart",
      e => {

        e.dataTransfer.setData(
          "text/plain",
          block.id
        );

      }
    );


    toolbox.appendChild(item);

  });


  /* ---------- SLOTS ---------- */

  const container =
    document.getElementById(
      "flowSlotsContainer"
    );

  container.innerHTML="";


  for(let i=0;i<task.stepsCount;i++) {

    const slot =
      document.createElement("div");

    slot.className="drop-slot";

    slot.dataset.index=i;

    slot.innerHTML = `

      <span class="empty-placeholder">
        ${getSlotInstruction(i)}
      </span>

    `;


    /*
      Drag over
    */

    slot.addEventListener(
      "dragover",
      e => {

        e.preventDefault();

        slot.classList.add(
          "drag-over"
        );

      }
    );


    slot.addEventListener(
      "dragleave",
      () => {

        slot.classList.remove(
          "drag-over"
        );

      }
    );


    /*
      Drop
    */

    slot.addEventListener(
      "drop",
      e => {

        e.preventDefault();

        slot.classList.remove(
          "drag-over"
        );

        const blockId =
          e.dataTransfer.getData(
            "text/plain"
          );

        assignBlockToSlot(
          blockId,
          i
        );

      }
    );


    /*
      แตะช่องว่าง
      แล้วเลือกบล็อก
    */

    slot.addEventListener(
      "click",
      () => {

        if(boardSlots[i]) return;

        highlightSlot(i);

      }
    );


    container.appendChild(slot);


    if(i < task.stepsCount-1) {

      const arrow =
        document.createElement("div");

      arrow.className =
        "flow-connector-line";

      container.appendChild(arrow);

    }

  }


  refreshToolboxState();

  updateProgress();

}


/* =====================================================
   SLOT INSTRUCTION
===================================================== */

function getSlotInstruction(index) {

  if(index === 0) {

    return "1️⃣ วางจุดเริ่มต้น (Start) ที่นี่";

  }

  if(index === tasks[activeKey].stepsCount-1) {

    return `5️⃣ วางจุดสิ้นสุด (End) ที่นี่`;

  }

  return `วางขั้นตอนที่ ${index+1} ที่นี่`;

}


/* =====================================================
   ASSIGN
===================================================== */

function assignBlockToSlot(
  blockId,
  slotIndex
) {

  if(!blockId) return;


  /*
    ถ้าบล็อกอยู่ช่องอื่น
    ให้ย้ายออกก่อน
  */

  for(const idx in boardSlots) {

    if(
      boardSlots[idx] === blockId &&
      Number(idx) !== slotIndex
    ) {

      delete boardSlots[idx];

      renderSlotContent(
        idx,
        null
      );

    }

  }


  /*
    ถ้ามีบล็อกเดิมอยู่ในช่อง
    ให้คืนกลับ toolbox
  */

  boardSlots[slotIndex] =
    blockId;


  renderSlotContent(
    slotIndex,
    blockId
  );


  refreshToolboxState();

  updateProgress();

  hideFeedback();

}


/* =====================================================
   CLICK TO FILL
===================================================== */

function fillNextAvailableSlot(blockId) {

  const task =
    tasks[activeKey];


  /*
    ถ้ามีอยู่แล้ว
    ไม่ทำซ้ำ
  */

  if(
    Object.values(boardSlots)
      .includes(blockId)
  ) {

    return;

  }


  for(
    let i=0;
    i<task.stepsCount;
    i++
  ) {

    if(
      boardSlots[i] === undefined
    ) {

      assignBlockToSlot(
        blockId,
        i
      );

      return;

    }

  }

}


/* =====================================================
   REMOVE
===================================================== */

function removeSlotContent(
  slotIndex
) {

  delete boardSlots[
    slotIndex
  ];

  renderSlotContent(
    slotIndex,
    null
  );

  refreshToolboxState();

  updateProgress();

  hideFeedback();

}


/* =====================================================
   RENDER SLOT
===================================================== */

function renderSlotContent(
  slotIndex,
  blockId
) {

  const slot =
    document.querySelector(
      `.drop-slot[data-index="${slotIndex}"]`
    );


  if(!slot) return;


  if(!blockId) {

    slot.innerHTML = `

      <span class="empty-placeholder">
        ${getSlotInstruction(
          Number(slotIndex)
        )}
      </span>

    `;

    return;

  }


  const block =
    tasks[activeKey]
      .blocks
      .find(
        b => b.id === blockId
      );


  slot.innerHTML = `

    <div class="placed-block type-${block.shape}">

      <div class="block-text">

        <span class="shape-tag shape-${block.shape}">
        </span>

        <span>
          ${block.text}
        </span>

      </div>

      <button
        class="btn-remove-slot"
        title="นำออก"
        onclick="removeSlotContent(${slotIndex})">

        ✕

      </button>

    </div>

  `;

}


/* =====================================================
   TOOLBOX STATE
===================================================== */

function refreshToolboxState() {

  const usedIds =
    Object.values(boardSlots);


  document
    .querySelectorAll(
      ".flow-block-source"
    )
    .forEach(el => {

      const id =
        el.id.replace(
          "block-",
          ""
        );


      if(
        usedIds.includes(id)
      ) {

        el.classList.add("used");

      } else {

        el.classList.remove("used");

      }

    });

}


/* =====================================================
   PROGRESS
===================================================== */

function updateProgress() {

  const count =
    Object.keys(boardSlots).length;

  document.getElementById(
    "progressDisplay"
  ).textContent=count;

}


/* =====================================================
   VALIDATE
===================================================== */

function validateSolution() {

  const task =
    tasks[activeKey];


  attempts++;

  document.getElementById(
    "attemptDisplay"
  ).textContent=attempts;


  const filled =
    Object.keys(boardSlots).length;


  if(
    filled < task.stepsCount
  ) {

    showFeedback(
      "warning",
      `
      ⚠️ <b>ยังไม่ครบทุกช่อง</b><br>
      ตอนนี้วางแล้ว ${filled}
      จาก ${task.stepsCount} ช่อง
      <br><br>
      ลองวางให้ครบก่อน แล้วกดตรวจสอบอีกครั้ง
      `
    );

    return;

  }


  let correct=true;


  for(
    let i=0;
    i<task.stepsCount;
    i++
  ) {

    if(
      boardSlots[i] !==
      task.solution[i]
    ) {

      correct=false;

      break;

    }

  }


  if(correct) {

    handleCorrect();

  } else {

    handleIncorrect();

  }

}


/* =====================================================
   CORRECT
===================================================== */

function handleCorrect() {

  if(taskCompleted) return;

  taskCompleted=true;


  /*
    คะแนน
    ครั้งแรก = 10
    ครั้งที่ 2 = 8
    ครั้งที่ 3 = 6
    ครั้งต่อไป = 5
  */

  let earned=5;

  if(attempts === 1) earned=10;
  else if(attempts === 2) earned=8;
  else if(attempts === 3) earned=6;


  totalScore += earned;

  updateScore();


  showFeedback(
    "success",
    `
    🎉 <b>ยอดเยี่ยมมาก!</b><br>
    นักเรียนเรียงลำดับ Flowchart ได้ถูกต้องทั้งหมด
    <br><br>
    ⭐ ได้รับ ${earned} คะแนน
    `
  );


  document.getElementById(
    "earnedScore"
  ).textContent=earned;


  document.getElementById(
    "successMessage"
  ).textContent =
    getSuccessMessage();


  document.getElementById(
    "successModal"
  ).style.display="flex";


  playSuccessSound();

}


/* =====================================================
   INCORRECT
===================================================== */

function handleIncorrect() {

  const container =
    document.getElementById(
      "flowSlotsContainer"
    );


  container.classList.remove("shake");

  void container.offsetWidth;

  container.classList.add("shake");


  showFeedback(
    "error",
    `
    ❌ <b>ยังไม่ถูกต้องครับ</b><br>
    ลองคิดใหม่อีกครั้งว่า
    <ul style="
      margin:6px 0 0 20px;
    ">
      <li>Start อยู่ด้านบนสุดหรือไม่?</li>
      <li>ขั้นตอนต่าง ๆ เรียงก่อน–หลังถูกต้องหรือไม่?</li>
      <li>End อยู่ด้านล่างสุดหรือไม่?</li>
    </ul>
    <br>
    💡 ถ้าต้องการความช่วยเหลือ กด “ขอคำใบ้”
    `
  );


  playErrorSound();

}


/* =====================================================
   HINT
===================================================== */

function showHint() {

  const task =
    tasks[activeKey];


  /*
    หาตำแหน่งแรกที่ผิด
  */

  let wrongIndex=-1;


  for(
    let i=0;
    i<task.stepsCount;
    i++
  ) {

    if(
      boardSlots[i] !==
      task.solution[i]
    ) {

      wrongIndex=i;

      break;

    }

  }


  if(wrongIndex === -1) {

    showFeedback(
      "success",
      "💡 ตอนนี้ลำดับถูกต้องแล้วครับ!"
    );

    return;

  }


  const correctId =
    task.solution[wrongIndex];


  const block =
    task.blocks.find(
      b => b.id === correctId
    );


  showFeedback(
    "warning",
    `
    💡 <b>คำใบ้</b><br>
    ช่องที่ ${wrongIndex+1}
    ควรเป็น
    <br><br>
    👉 <b>${block.text}</b>
    `
  );


  /*
    Highlight ช่องที่ควรแก้
  */

  const slot =
    document.querySelector(
      `.drop-slot[data-index="${wrongIndex}"]`
    );


  if(slot) {

    slot.classList.add("highlight");

    setTimeout(
      () => {
        slot.classList.remove(
          "highlight"
        );
      },
      1800
    );

  }

}


/* =====================================================
   FEEDBACK
===================================================== */

function showFeedback(
  type,
  html
) {

  const feedback =
    document.getElementById(
      "feedbackBox"
    );


  feedback.className =
    `status-box status-${type}`;


  feedback.innerHTML=html;

  feedback.style.display="block";

}


function hideFeedback() {

  const feedback =
    document.getElementById(
      "feedbackBox"
    );

  feedback.style.display="none";

}


/* =====================================================
   SCORE
===================================================== */

function updateScore() {

  document.getElementById(
    "scoreDisplay"
  ).textContent=totalScore;

}


/* =====================================================
   SUCCESS MESSAGE
===================================================== */

function getSuccessMessage() {

  const messages=[

    "นักเรียนสามารถเรียงลำดับขั้นตอนของอัลกอริทึมได้ถูกต้องแล้ว!",

    "เก่งมาก! นักเรียนเข้าใจการทำงานของ Flowchart แล้ว",

    "สุดยอด! พร้อมสำหรับภารกิจต่อไปแล้วครับ"

  ];


  return messages[
    Math.floor(
      Math.random()*messages.length
    )
  ];

}


/* =====================================================
   MODAL
===================================================== */

function closeSuccessModal() {

  document.getElementById(
    "successModal"
  ).style.display="none";

}


/* =====================================================
   HIGHLIGHT SLOT
===================================================== */

function highlightSlot(index) {

  document
    .querySelectorAll(
      ".drop-slot"
    )
    .forEach(
      slot =>
        slot.classList.remove(
          "highlight"
        )
    );


  const slot =
    document.querySelector(
      `.drop-slot[data-index="${index}"]`
    );


  if(slot) {

    slot.classList.add(
      "highlight"
    );

  }

}


/* =====================================================
   SIMPLE SOUND
   ใช้ Web Audio API
   ไม่ต้องโหลดไฟล์เสียงภายนอก
===================================================== */

function playSuccessSound() {

  try {

    const AudioContext =
      window.AudioContext ||
      window.webkitAudioContext;

    if(!AudioContext) return;


    const ctx =
      new AudioContext();


    const notes=[
      523.25,
      659.25,
      783.99
    ];


    notes.forEach(
      (frequency,index) => {

        const oscillator =
          ctx.createOscillator();

        const gain =
          ctx.createGain();


        oscillator.frequency.value =
          frequency;

        oscillator.type="sine";


        gain.gain.setValueAtTime(
          .001,
          ctx.currentTime
        );

        gain.gain.exponentialRampToValueAtTime(
          .15,
          ctx.currentTime +
          index*.12 +
          .03
        );

        gain.gain.exponentialRampToValueAtTime(
          .001,
          ctx.currentTime +
          index*.12 +
          .25
        );


        oscillator.connect(gain);

        gain.connect(ctx.destination);


        oscillator.start(
          ctx.currentTime +
          index*.12
        );

        oscillator.stop(
          ctx.currentTime +
          index*.12 +
          .27
        );

      }
    );

  } catch(e) {}

}


function playErrorSound() {

  try {

    const AudioContext =
      window.AudioContext ||
      window.webkitAudioContext;

    if(!AudioContext) return;


    const ctx =
      new AudioContext();

    const oscillator =
      ctx.createOscillator();

    const gain =
      ctx.createGain();


    oscillator.type="sine";

    oscillator.frequency.value=220;

    gain.gain.value=.08;


    oscillator.connect(gain);

    gain.connect(ctx.destination);


    oscillator.start();

    oscillator.stop(
      ctx.currentTime+.18
    );

  } catch(e) {}

}


